{
  "description": "Persistent role identity, stale-generation rejection, context anchoring, role policy, and compaction health.",
  "hooks": {
    "SessionStart": [{
      "matcher": "startup|resume|clear|compact",
      "hooks": [{
        "type": "command",
        "command": "node --no-warnings \"${PLUGIN_ROOT}/dist/hook.mjs\"",
        "commandWindows": "node --no-warnings \"%PLUGIN_ROOT%\\dist\\hook.mjs\"",
        "statusMessage": "Restoring persistent role",
        "additionalContextLimit": 6000,
        "timeout": 10
      }]
    }],
    "UserPromptSubmit": [{
      "hooks": [{
        "type": "command",
        "command": "node --no-warnings \"${PLUGIN_ROOT}/dist/hook.mjs\"",
        "commandWindows": "node --no-warnings \"%PLUGIN_ROOT%\\dist\\hook.mjs\"",
        "statusMessage": "Checking role generation",
        "additionalContextLimit": 6000,
        "timeout": 10
      }]
    }],
    "PreToolUse": [{
      "matcher": "*",
      "hooks": [{
        "type": "command",
        "command": "node --no-warnings \"${PLUGIN_ROOT}/dist/hook.mjs\"",
        "commandWindows": "node --no-warnings \"%PLUGIN_ROOT%\\dist\\hook.mjs\"",
        "statusMessage": "Enforcing role policy",
        "additionalContextLimit": 3000,
        "timeout": 10
      }]
    }],
    "PostToolUse": [{
      "matcher": "*",
      "hooks": [{
        "type": "command",
        "command": "node --no-warnings \"${PLUGIN_ROOT}/dist/hook.mjs\"",
        "commandWindows": "node --no-warnings \"%PLUGIN_ROOT%\\dist\\hook.mjs\"",
        "statusMessage": "Recording role event",
        "timeout": 10
      }]
    }],
    "PreCompact": [{
      "matcher": "manual|auto",
      "hooks": [{
        "type": "command",
        "command": "node --no-warnings \"${PLUGIN_ROOT}/dist/hook.mjs\"",
        "commandWindows": "node --no-warnings \"%PLUGIN_ROOT%\\dist\\hook.mjs\"",
        "statusMessage": "Checkpointing role state",
        "timeout": 10
      }]
    }],
    "PostCompact": [{
      "matcher": "manual|auto",
      "hooks": [{
        "type": "command",
        "command": "node --no-warnings \"${PLUGIN_ROOT}/dist/hook.mjs\"",
        "commandWindows": "node --no-warnings \"%PLUGIN_ROOT%\\dist\\hook.mjs\"",
        "statusMessage": "Updating generation health",
        "timeout": 10
      }]
    }],
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "node --no-warnings \"${PLUGIN_ROOT}/dist/hook.mjs\"",
        "commandWindows": "node --no-warnings \"%PLUGIN_ROOT%\\dist\\hook.mjs\"",
        "statusMessage": "Recording role stop",
        "timeout": 10
      }]
    }],
    "SessionEnd": [{
      "hooks": [{
        "type": "command",
        "command": "node --no-warnings \"${PLUGIN_ROOT}/dist/hook.mjs\"",
        "commandWindows": "node --no-warnings \"%PLUGIN_ROOT%\\dist\\hook.mjs\"",
        "statusMessage": "Closing role generation session",
        "timeout": 3
      }]
    }]
  }
}
